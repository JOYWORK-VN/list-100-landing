# Copy file này sang .env.local cho dev, và set tương ứng trên Vercel khi deploy

# === SITE URL ===
# Production: https://joywork.vn
# Vercel preview: tự động override bởi VERCEL_URL (không cần set tay)
NEXT_PUBLIC_SITE_URL=https://joywork.vn

# === RESEND (gửi email xác nhận + notify team) ===
# Tạo tài khoản tại https://resend.com → API Keys → tạo key mới
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email "from" — phải verify domain joywork.vn trên Resend trước
# (Setup → Domains → Add domain → thêm DNS records vào joywork.vn)
RESEND_FROM_EMAIL=list100@joywork.vn

# === EMAIL NOTIFY TEAM ===
# Email nhận đăng ký mới — có thể trùng RESEND_FROM_EMAIL hoặc khác
TEAM_NOTIFICATION_EMAIL=list100@joywork.vn

# === AIRTABLE (lưu đăng ký) ===
# 1. Tạo Personal Access Token: https://airtable.com/create/tokens
#    - Scope: data.records:write, schema.bases:read
# 2. Base ID: lấy từ URL base (https://airtable.com/appXXXXXXXXXXXXXX/...)
# 3. Table Name: tên table đã tạo (mặc định: Registrations)
#    - Tạo các field: Company Name, Industry, Company Size, Location,
#      Contact Name, Contact Position, Email, Phone, Readiness,
#      Referral Source, Timestamp
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_NAME=Registrations

# === LARK WEBHOOK (notify team khi có đăng ký mới) ===
# Tạo Lark Bot: Lark → Settings → Bots → Create bot → Copy webhook URL
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxx
